# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=dev_verify_token
WHATSAPP_APP_SECRET=your_app_secret_here
WHATSAPP_API_TOKEN=your_permanent_token_here
WHATSAPP_PHONE_ID=your_phone_number_id_here

# Redis
REDIS_URL=redis://localhost:6379

# PostgreSQL
# Railway genera esta URL automáticamente en la variable DATABASE_URL
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/brain_omni

# App
DEBUG=false
